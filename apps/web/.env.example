# Where the Vite dev server proxies /api requests (Django dev server).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Production only: absolute URL of the deployed API, e.g. https://api.example.com/api
# VITE_API_BASE_URL=

# Serve the API from MSW mocks (true) or the real backend (false).
VITE_ENABLE_MOCKS=true
# Artificial latency for mocked responses, in ms.
VITE_MOCK_DELAY_MS=700
