# Copy to .env for local overrides. Dev settings work without any .env at all.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# DATABASE_URL=postgres://user:pass@localhost:5432/skyrig
# CACHE_URL=redis://localhost:6379/0

# Third-party APIs (server-side only, never sent to the browser)
# HERE routing + geocoding key: https://platform.here.com (Access Manager → Apps → API Keys)
HERE_API_KEY=

# Production only (used by config.settings.prod)
# DJANGO_SETTINGS_MODULE=config.settings.prod
# CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com
